# PostgreSQL connection string used by the booking and admin dashboard.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Set your own private admin password.
ADMIN_PASSWORD=replace-with-a-long-random-password

# Generate a long random session signing key, for example with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-random-64-character-hex-key
